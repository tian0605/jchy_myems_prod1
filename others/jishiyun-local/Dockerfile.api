ARG PYTHON_IMAGE=python:3.10-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
# Do not include developer .env files, uploads or tests in the acceptance image.
COPY myems-api/requirements.txt ./
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --timeout 120 --index-url "$PIP_INDEX_URL" -r requirements.txt
COPY myems-jishiyun/pyproject.toml /opt/jishiyun/
COPY myems-jishiyun/myems_jishiyun /opt/jishiyun/myems_jishiyun
RUN pip install --no-cache-dir --no-build-isolation --no-deps /opt/jishiyun
COPY myems-api/core ./core
COPY myems-api/reports ./reports
COPY myems-api/excelexporters ./excelexporters
COPY myems-api/i18n ./i18n
COPY myems-api/app.py myems-api/config.py ./
RUN mkdir -p /var/www/myems-admin/upload
EXPOSE 8000
CMD ["gunicorn", "app:api", "-b", "0.0.0.0:8000", "--timeout", "120", "--workers=2", "--access-logfile", "-"]
